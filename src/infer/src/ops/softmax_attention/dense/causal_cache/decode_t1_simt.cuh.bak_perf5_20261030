// Decode T=1 SIMT flash attention (AMD port, gfx1201):
//   one CTA per (2 q rows, key split) sharing one kv head; Q rows in registers;
//   online softmax with batch-of-4 keys (4 warps, one key per warp, warp shfl
//   reduce); V read directly and accumulated per lane. Emits the same partial
//   (acc/m/l) contract as the WMMA partial kernel.
// Layout: [kvh][key][d] token-major via paged planes (page = block_table[key>>6]).
//   K/V planes: PageMajor [leading][64][KVH][pages], leading = D (bf16/fp16) or
//   q4_0 codes.
#include "ops/common/math.cuh"
#include "ops/common/memory.cuh"
#include "ops/common/warp.cuh"
#include "ops/softmax_attention/dense/causal_cache/geometry.cuh"
#include "ops/softmax_attention/dense/causal_cache/prompt_common.cuh"
#include "ops/kv_cache/q4_0_codec.cuh"
#include "ops/kv_cache/fp8_e4m3_row_codec.cuh"
#include "ops/kv_cache/int8_g64_codec.cuh"
#include "ops/kv_cache/hadamard_d256.cuh"
#include "ops/kernel/paged_kv_address.cuh"

#include <math_constants.h>
#include <cuda_bf16.h>
#include <cuda_fp16.h>

#include <cstdint>

namespace ninfer::ops {

namespace decode_t1_simt_detail {

// 8 warps: the decode loop is latency-bound (two dependent cache reads + a block-wide
// softmax reduction per key batch), so more warps in flight per CTA hide the KV load
// latency. Measured on gfx1201 @32K (see HANDOFF_20261027d): 4 warps -> 6.0 ms/step of
// attention, 8 warps -> see the handoff for the number.
constexpr int kSimtThreads = 256;      // 8 warps
constexpr int kSimtD       = kCausalPromptHeadDim;  // 256
constexpr int kSimtBatch   = 8;        // keys per softmax batch (one per warp)
constexpr int kSimtQRows   = 2;        // q rows per CTA (share the kv head)

template <typename Geometry>
__device__ __forceinline__ const __nv_bfloat16* simt_k_ptr(
    const __nv_bfloat16* cache_k, const std::int32_t* block_table, int kv_head, int key,
    int d) {
    const int page = block_table[key >> kPagedKVPageShift];
    const int page_off = key & kPagedKVPageMask;
    return cache_k + paged_kv_element_offset<kSimtD, Geometry::KVHeads>(page, kv_head, page_off,
                                                                         0) + d;
}

template <typename Geometry>
__device__ __forceinline__ const __half* simt_v_ptr(const __half* cache_v,
                                                     const std::int32_t* block_table,
                                                     int kv_head, int key, int d) {
    const int page = block_table[key >> kPagedKVPageShift];
    const int page_off = key & kPagedKVPageMask;
    return cache_v + paged_kv_element_offset<kSimtD, Geometry::KVHeads>(page, kv_head, page_off,
                                                                        0) + d;
}

} // namespace decode_t1_simt_detail

template <typename Geometry, typename CacheInput, bool KFp16, bool KQ4, bool KFp8 = false,
          bool KInt4E8 = false, int QRows = decode_t1_simt_detail::kSimtQRows>
// minBlocksPerMultiprocessor: the 6-row variant needs ~144 float accumulators/thread, so
    // asking for 1 block/SM lets the compiler spend up to 256 registers and pin occupancy at
    // 12.5%. The 2-row variant needs ~48, so request 4 blocks/SM (<=64 regs/thread) to reach
    // 50% occupancy on gfx1201.
    __launch_bounds__(decode_t1_simt_detail::kSimtThreads, (QRows <= 2 ? 4 : 2))
__global__ void causal_decode_t1_simt_partial_kernel(
    const __nv_bfloat16* __restrict__ q, CacheInput input,
    __nv_bfloat16* __restrict__ cache_k,
    __half* __restrict__ cache_v, __half* __restrict__ cache_k_scale,
    __half* __restrict__ cache_v_scale, const std::int32_t* __restrict__ block_tables,
    const std::int32_t* __restrict__ table_rows, std::int32_t table_stride,
    const std::int32_t* __restrict__ positions, float scale, float* __restrict__ partial_acc,
    float* __restrict__ partial_m, float* __restrict__ partial_l, int skip_attn = 0,
    // AMD port: multi-token verify. The caller launches this kernel once per token with
    // token_base = that token's column, so q / fresh K,V / positions all slice to one
    // column and the kernel body stays identical to the T=1 decode path. Default 0 keeps
    // every existing T=1 call site bit-identical.
    int token_base = 0) {
    using namespace decode_t1_simt_detail;
    constexpr int D        = kSimtD;
    constexpr int Threads  = kSimtThreads;
    constexpr int Warps    = kSimtThreads / 32;
    constexpr int Batch    = kSimtBatch;
    constexpr int QR       = QRows;
    constexpr int GroupSize = Geometry::QHeads / Geometry::KVHeads;

    const int q0   = static_cast<int>(blockIdx.x) * QR;   // first q row of this CTA
    const int split = static_cast<int>(blockIdx.y);
    // skip_attn (set from the host via NINFER_SKIP_ATTN_SIMT): write neutral partials and
    // bail out, so the caller can measure what the K/V read + online softmax actually costs.
    // The WMMA route has NINFER_SKIP_ATTN; this SIMT route ignored it.
    if (skip_attn == 1) {
        if (threadIdx.x == 0) {
#pragma unroll
            for (int r = 0; r < QR; ++r) {
                // Canonical partial layout [split][token][q_head] (tokens == 1 here): this is
                // what causal_partial_{stat,acc}_index describes and what the reduce kernel
                // (causal_attention_small_t_reduce_output_kernel) reads.
                const std::int64_t stat = (q0 + r) + Geometry::QHeads * static_cast<std::int64_t>(split);
                partial_m[stat] = -CUDART_INF_F;
                partial_l[stat] = 0.0f;
                for (int d = 0; d < D; ++d) {
                    partial_acc[stat * D + d] = 0.0f;
                }
            }
        }
        return;
    }
    const int kv_head = q0 / GroupSize;                   // q0..q0+QR-1 share it
    const int tid    = static_cast<int>(threadIdx.x);
    const int lane   = tid & 31;
    const int warp   = tid >> 5;

    // window / split semantics identical to the WMMA partial kernel.
    const int q_abs  = positions[token_base];
    const int window = q_abs + 1;
    const int active_split_count =
        causal_small_t_active_splits<Geometry, false>(window, gridDim.y, 1);

    const auto write_neutral = [&](int qh) {
        // Canonical [split][token][q_head] layout, tokens == 1 (see causal_partial_stat_index).
        const std::int64_t stat = qh + Geometry::QHeads * static_cast<std::int64_t>(split);
        partial_m[stat] = -CUDART_INF_F;
        partial_l[stat] = 0.0f;
        for (int d = 0; d < D; ++d) partial_acc[stat * D + d] = 0.0f;
    };
    if (split >= active_split_count) {
        if (tid == 0) {
#pragma unroll
            for (int r = 0; r < QR; ++r) write_neutral(q0 + r);
        }
        return;
    }

    const std::int32_t* block_table = block_tables +
        (table_rows != nullptr ? table_rows[0] : 0) * table_stride;

    if (skip_attn == 2 && blockIdx.x == 0 && blockIdx.y == 0 && tid == 0) {
        if constexpr (KInt4E8) {
            const int pg0 = block_table[0];
            const std::int64_t kso =
                kv_cache_int8_quant_scale_index<Geometry>(pg0, kv_head, 0, 0);
            const std::int64_t vso =
                kv_cache_int4_value_scale_index<Geometry>(pg0, kv_head, 0, 0);
            unsigned short ksb = 0, vsb = 0;
            __builtin_memcpy(&ksb, &cache_k_scale[kso], 2);
            __builtin_memcpy(&vsb, &cache_v_scale[vso], 2);
            const auto* kc = reinterpret_cast<const unsigned char*>(cache_k);
            const auto kci = kv_cache_int4_value_code_index<Geometry>(pg0, kv_head, 0, 0);
            unsigned short kg[4], vg[8];
            for (int g = 0; g < 4; ++g) {
                const std::int64_t o = kv_cache_int8_quant_scale_index<Geometry>(pg0, kv_head, g, 0);
                __builtin_memcpy(&kg[g], &cache_k_scale[o], 2);
            }
            for (int g = 0; g < 8; ++g) {
                const std::int64_t o = kv_cache_int4_value_scale_index<Geometry>(pg0, kv_head, g, 0);
                __builtin_memcpy(&vg[g], &cache_v_scale[o], 2);
            }
            printf("[simt-peek] row=%d tbl0=%d tbl1=%d k0=0x%04x kbyte=0x%02x "
                   "kg=0x%04x,0x%04x,0x%04x,0x%04x vg=0x%04x,0x%04x,0x%04x,0x%04x,"
                   "0x%04x,0x%04x,0x%04x,0x%04x ptr=%p\n",
                   (table_rows != nullptr ? table_rows[0] : -1), pg0, block_table[1],
                   (unsigned)ksb, (unsigned)kc[kci],
                   (unsigned)kg[0], (unsigned)kg[1], (unsigned)kg[2], (unsigned)kg[3],
                   (unsigned)vg[0], (unsigned)vg[1], (unsigned)vg[2], (unsigned)vg[3],
                   (unsigned)vg[4], (unsigned)vg[5], (unsigned)vg[6], (unsigned)vg[7],
                   (const void*)cache_k);
        }
    }
    constexpr int Bc = 64;  // keys per logical tile (same family as WMMA Bc)
    const int logical_tiles = div_up(window, Bc);
    const bool tile_split   = logical_tiles >= active_split_count;
    const int units_per_split =
        tile_split ? div_up(logical_tiles, active_split_count) : div_up(window, active_split_count);
    const int split_start = split * units_per_split * (tile_split ? Bc : 1);
    const int split_limit = split_start + units_per_split * (tile_split ? Bc : 1);
    const int split_end   = (split_limit < window) ? split_limit : window;
    // AMD DEBUG (NINFER_SIMT_DBGP=1 -> skip_attn==2): report the kernel-side window/split
    // derivation for the first CTA so a host-side trace can be checked against what the
    // device actually computed. Skips nothing; the kernel keeps running.
    if (skip_attn == 2 && blockIdx.x == 0 && blockIdx.y == 0 && tid == 0) {
        printf("[simt-dbg] qh0_abs=%d window=%d active=%d tiles=%d units=%d start=%d end=%d "
               "splits=%d tokens=%d token_base=%d\n",
               q_abs, window, active_split_count, logical_tiles, units_per_split, split_start,
               split_end, static_cast<int>(gridDim.y), static_cast<int>(Bc), token_base);
    }
    if (split_start >= split_end) {
        if (tid == 0) {
#pragma unroll
            for (int r = 0; r < QR; ++r) write_neutral(q0 + r);
        }
        return;
    }

    // ---- writes_cache: store the fresh K/V row (q_abs) into the paged planes ----
    if constexpr (CacheInput::writes_cache) {
        // Only the split whose disjoint range contains the fresh row (window-1) owns
        // the append. It is the only CTA that reads that row, so duplicating this
        // append in other split CTAs created an inter-CTA write/read race on it.
        const bool owns_fresh_row = split_start <= window - 1 && window - 1 < split_end;
        if (owns_fresh_row) {
            const int p_tok          = positions[token_base];
        const int physical_page  = paged_kv_physical_page(block_table, p_tok);
        const int page_off       = p_tok & kPagedKVPageMask;
        if constexpr (KQ4) {
            constexpr int BlocksPerRow = D / kQ4_0Block;  // 8
            const std::int64_t code_base = q4_0_code_offset<Geometry::KVHeads>(
                physical_page, kv_head, page_off, 0);
            const std::int64_t scale_base = q4_0_scale_offset<Geometry::KVHeads>(
                physical_page, kv_head, page_off, 0);
#pragma unroll
            for (int kv = 0; kv < 2; ++kv) {
#pragma unroll
                for (int half = 0; half < 2; ++half) {
                    const int block = warp + half * (Threads >> 5);
                    if (block >= BlocksPerRow) { continue; }
                    const int d = block * kQ4_0Block + lane;
                    const std::int64_t new_off = kv_cache_int8_new_index<Geometry>(kv_head, d, token_base);
                    if (kv == 0) {
                        q4_0_block_encode(
                            __bfloat162float(input.k[new_off]), lane,
                            reinterpret_cast<std::uint8_t*>(cache_k) + code_base +
                                block * kQ4_0CodesPerBlock,
                            cache_k_scale[scale_base + block]);
                    } else {
                        q4_0_block_encode(
                            __bfloat162float(input.v[new_off]), lane,
                            reinterpret_cast<std::uint8_t*>(cache_v) + code_base +
                                block * kQ4_0CodesPerBlock,
                            cache_v_scale[scale_base + block]);
                    }
                }
            }
        } else if constexpr (KFp8) {
            // Row-scaled E4M3FP8 with the D256 Hadamard rotation the fp8 cache uses:
            // warp 0's lanes each own dims lane+32*u, rotate in place, then the row
            // absmax (over the rotated values) fixes the scale; codes go to dim order.
            const int lane0 = static_cast<int>(threadIdx.x) & 31;
            if (threadIdx.x < 32) {
                float kv_r[8];
                float vv_r[8];
#pragma unroll
                for (int u = 0; u < 8; ++u) {
                    const int dim = lane0 + 32 * u;
                    kv_r[u] = __bfloat162float(
                        input.k[kv_cache_fp8_src_index<Geometry>(kv_head, dim, token_base)]);
                    vv_r[u] = __bfloat162float(
                        input.v[kv_cache_fp8_src_index<Geometry>(kv_head, dim, token_base)]);
                }
                normalized_hadamard_d256_inplace(kv_r, lane0);
                // K is stored rotated; V is NOT (matches small_t_fp8's writes_cache).
                float klocal = 0.0f, vlocal = 0.0f;
#pragma unroll
                for (int u = 0; u < 8; ++u) {
                    klocal = fmaxf(klocal, fabsf(kv_r[u]));
                    vlocal = fmaxf(vlocal, fabsf(vv_r[u]));
                }
                float krowmax = klocal, vrowmax = vlocal;
#pragma unroll
                for (int off = 16; off > 0; off >>= 1) {
                    krowmax = fmaxf(krowmax, __shfl_xor_sync(0xffffffffu, krowmax, off));
                    vrowmax = fmaxf(vrowmax, __shfl_xor_sync(0xffffffffu, vrowmax, off));
                }
                const auto kq = kv_cache_fp8_quant_params(krowmax);
                const auto vq = kv_cache_fp8_quant_params(vrowmax);
#pragma unroll
                for (int u = 0; u < 8; ++u) {
                    const int dim = lane0 + 32 * u;
                    std::uint8_t* kdst =
                        reinterpret_cast<std::uint8_t*>(cache_k) +
                        kv_cache_fp8_code_index<Geometry>(physical_page, kv_head, dim, page_off);
                    std::uint8_t* vdst =
                        reinterpret_cast<std::uint8_t*>(cache_v) +
                        kv_cache_fp8_code_index<Geometry>(physical_page, kv_head, dim, page_off);
                    *kdst = kq.inverse_scale == 0.0f
                                ? 0
                                : kv_cache_fp8_quant_code(kv_r[u], kq.inverse_scale);
                    *vdst = vq.inverse_scale == 0.0f
                                ? 0
                                : kv_cache_fp8_quant_code(vv_r[u], vq.inverse_scale);
                }
                if (threadIdx.x == 0) {
                    cache_k_scale[kv_cache_fp8_scale_index<Geometry>(physical_page, kv_head,
                                                                      page_off)] = kq.scale;
                    cache_v_scale[kv_cache_fp8_scale_index<Geometry>(physical_page, kv_head,
                                                                      page_off)] = vq.scale;
                }
            }
        } else if constexpr (KInt4E8) {
            // rk4v4-e8 fresh-row append: warp 0's lanes own dims lane+32*u (stride-32),
            // K rotated then stored via the packed E8/int4 key codec, V packed int4 (not
            // rotated), matching kv_cache_append_full_i8v_kernel<Int4E8> exactly.
            const int lane0 = static_cast<int>(threadIdx.x) & 31;
            if (threadIdx.x < 32) {
                float k_values[8];
                float v_values[8];
#pragma unroll
                for (int u = 0; u < 8; ++u) {
                    const int dim = lane0 + 32 * u;
                    k_values[u] = __bfloat162float(input.k[
                        kv_cache_int8_quant_src_index<Geometry>(kv_head, dim, token_base)]);
                    v_values[u] = __bfloat162float(input.v[
                        kv_cache_int8_quant_src_index<Geometry>(kv_head, dim, token_base)]);
                }
                normalized_hadamard_d256_inplace(k_values, lane0);
#pragma unroll
                for (int group = 0; group < kKVCacheInt8Groups; ++group) {
                    kv_cache_i8_family_store_key_group<Geometry, KvKeyCoding::Int4E8>(
                        reinterpret_cast<std::int8_t*>(cache_k), cache_k_scale, physical_page,
                        kv_head, group, page_off, lane0, k_values[2 * group],
                        k_values[2 * group + 1]);
                    const float v0 = v_values[2 * group];
                    const float v1 = v_values[2 * group + 1];
                    const float v_abs_lo = warp_max(fabsf(v0), 0xffffffffu);
                    const float v_abs_hi = warp_max(fabsf(v1), 0xffffffffu);
                    const auto v_quant = kv_cache_int4_quant_params(v_abs_lo);
                    const auto v_quant_hi = kv_cache_int4_quant_params(v_abs_hi);
                    const std::int8_t c0 = kv_cache_int4_quant_code(v0, v_quant.inverse_scale);
                    const std::int8_t c1 =
                        kv_cache_int4_quant_code(v1, v_quant_hi.inverse_scale);
                    const int partner0 = __shfl_xor_sync(0xffffffffu, static_cast<int>(c0), 1);
                    const int partner1 = __shfl_xor_sync(0xffffffffu, static_cast<int>(c1), 1);
                    if ((lane0 & 1) == 0) {
                        auto* packed_v = reinterpret_cast<std::uint8_t*>(cache_v);
                        const std::int64_t packed_base = kv_cache_int4_value_code_index<Geometry>(
                            physical_page, kv_head, group * (kKVCacheInt8Group / 2), page_off);
                        packed_v[packed_base + (lane0 >> 1)] =
                            kv_cache_int4_pack(c0, static_cast<std::int8_t>(partner0));
                        packed_v[packed_base + (lane0 >> 1) + 16] =
                            kv_cache_int4_pack(c1, static_cast<std::int8_t>(partner1));
                    }
                    if (lane0 == 0) {
                        cache_v_scale[kv_cache_int4_value_scale_index<Geometry>(
                            physical_page, kv_head, 2 * group, page_off)] = v_quant.scale;
                        cache_v_scale[kv_cache_int4_value_scale_index<Geometry>(
                            physical_page, kv_head, 2 * group + 1, page_off)] = v_quant_hi.scale;
                    }
                }
            }
        } else {
            for (int chunk = tid; chunk < (D / 8); chunk += Threads) {
                const int d = chunk * 8;
                const std::int64_t new_off = kv_cache_int8_new_index<Geometry>(kv_head, d, token_base);
                const std::int64_t cache_off = causal_cache_index<Geometry>(
                    physical_page, kv_head, d, page_off);
                if constexpr (KFp16) {
                    store_vec(reinterpret_cast<__half*>(&cache_k[cache_off]),
                              bf16x8_bits_to_f16x8_bits(load_vec<int4>(&input.k[new_off])));
                } else {
                    store_vec(&cache_k[cache_off], load_vec<int4>(&input.k[new_off]));
                }
                store_vec(&cache_v[cache_off],
                          bf16x8_bits_to_f16x8_bits(load_vec<int4>(&input.v[new_off])));
            }
            }
            __syncthreads();
        }
    }

    // Q rows (2 per CTA) -> registers, each lane owns 8 d per row.
    float qr[QR][8];
#pragma unroll
    for (int r = 0; r < QR; ++r) {
        const __nv_bfloat16* q_ptr = q + causal_prompt_q_index<Geometry>(q0 + r, 0, token_base);
#pragma unroll
        for (int j = 0; j < 8; ++j) qr[r][j] = __bfloat162float(q_ptr[lane * 8 + j]);
    }
    if (skip_attn == 2 && blockIdx.x == 0 && blockIdx.y == 0 && tid == 0) {
        const __nv_bfloat16* qraw = q + causal_prompt_q_index<Geometry>(q0, 0, token_base);
        const unsigned short* qb = reinterpret_cast<const unsigned short*>(qraw);
        printf("[simt-qraw] tok=%d qabs=%d qptr=%p b=%04x,%04x,%04x,%04x\n",
               token_base, positions[token_base], (const void*)q, qb[0], qb[1], qb[2], qb[3]);
    }
    // KFp8 / KInt4E8: cached K is Hadamard-rotated at append time (K only; V is stored
    // unrotated), so Q must be rotated the same way. The transform works on the
    // stride-32 arrangement (dim = lane + 32*u); the K/V reads below use it too.
    float q_rot[QR][8];
    if constexpr (KFp8) {
#pragma unroll
        for (int r = 0; r < QR; ++r) {
            const __nv_bfloat16* q_ptr = q + causal_prompt_q_index<Geometry>(q0 + r, 0, token_base);
#pragma unroll
            for (int u = 0; u < 8; ++u) q_rot[r][u] = __bfloat162float(q_ptr[lane + 32 * u]);
            normalized_hadamard_d256_inplace(q_rot[r], lane);
        }
    }
    // PERF 2026-10-30 #3 (int4 read path): the packed int4 code plane is contiguous in dim, so a
    // lane that owns dims 8*lane..8*lane+7 can fetch them with ONE 4-byte load plus ONE group
    // scale. The Hadamard above works on the stride-32 arrangement (dim = lane + 32*u), so
    // re-map the rotated q into the contiguous arrangement: rotated dim 8L+j lives in source
    // lane (8L+j)%32 = 8*(L%4)+j, at register index (8L+j)/32 = L/4. 64 shuffles per q row,
    // executed ONCE per launch - negligible next to one pass over a 96K-key window.
    float q_rotc[QR][8];
    if constexpr (KInt4E8) {
        // Rotate through shared memory instead of a register transpose: a shuffle transpose
        // needs q_rot and q_rotc live at the same time (2*QR*8 = 96 floats) and this kernel
        // already sits on the VGPR ceiling, so it spilled and the key loop ran ~15-25% slower.
        // Warp 0 rotates one row (8 dims per lane) into a 256-float buffer; every lane then
        // picks up its own contiguous dims 8*lane..8*lane+7.
        __shared__ float q_rot_s[256];
        const int warp_id = static_cast<int>(threadIdx.x) >> 5;
#pragma unroll
        for (int r = 0; r < QR; ++r) {
            if (warp_id == 0) {
                const __nv_bfloat16* q_ptr =
                    q + causal_prompt_q_index<Geometry>(q0 + r, 0, token_base);
                float tmp[8];
#pragma unroll
                for (int u = 0; u < 8; ++u) tmp[u] = __bfloat162float(q_ptr[lane + 32 * u]);
                normalized_hadamard_d256_inplace(tmp, lane);
#pragma unroll
                for (int u = 0; u < 8; ++u) q_rot_s[lane + 32 * u] = tmp[u];
            }
            __syncthreads();
#pragma unroll
            for (int j = 0; j < 8; ++j) q_rotc[r][j] = q_rot_s[lane * 8 + j];
            __syncthreads();
        }
    }

    __shared__ float s_batch[QR][Warps];
    __shared__ float m_upd[QR];
    __shared__ float l_batch[QR];
    float m[QR], l[QR];
    float o[QR][8];
#pragma unroll
    for (int r = 0; r < QR; ++r) { m[r] = -CUDART_INF_F; l[r] = 0.0f; }
#pragma unroll
    for (int r = 0; r < QR; ++r)
#pragma unroll
        for (int j = 0; j < 8; ++j) o[r][j] = 0.0f;

    const int d0 = lane * 8;
    // WITNESS (temporary debug): per-thread checksums so a PDBG A/B pair can tell whether the
    // V/K bytes actually read, the softmax weights, and the final write-back all match. Stored
    // into acc padding slabs (>=768) that the reducer never reads.
    float w_vsum = 0.0f, w_ksum = 0.0f, w_psum = 0.0f, w_pgs = 0.0f;
    for (int kb = split_start; kb < split_end; kb += Batch) {
        const int key = kb + warp;
        if (skip_attn == 2 && blockIdx.x == 0 && blockIdx.y == 0 && tid == 0 &&
            kb == split_start) {
            printf("[simt-loop] kb=%d key=%d end=%d flags=%d%d%d%d warps=%d batch=%d\n", kb, key,
                   split_end, (int)KQ4, (int)KFp16, (int)KFp8, (int)KInt4E8, (int)Warps,
                   (int)Batch);
        }
        float s[QR];
#pragma unroll
        // BUGFIX 2026-10-29: this used to be -CUDART_INF_F for every lane, which makes the
        // accumulation below (-inf + finite == -inf) poison every valid key: bmax stays -inf,
        // l becomes NaN, and small_t.cuh writes an exact 0.0f. Only the padding warp (whose key
        // is past the window) may keep -inf so it cannot win the max.
        for (int r = 0; r < QR; ++r) s[r] = (key < split_end) ? 0.0f : -CUDART_INF_F;

        if (key < split_end) {
            if constexpr (KQ4) {
                // q4_0 K: 8 d = 2 q4 blocks; dequant once, dot both q rows
                const int page = block_table[key >> kPagedKVPageShift];
                const int page_off = key & kPagedKVPageMask;
                const std::int64_t code_off = q4_0_code_offset<Geometry::KVHeads>(
                    page, kv_head, page_off, (d0 / kQ4_0Block) * kQ4_0Block) + (d0 & 15);
                const std::int64_t scale_off = q4_0_scale_offset<Geometry::KVHeads>(
                    page, kv_head, page_off, d0);
                const std::uint64_t codes8 = *reinterpret_cast<const std::uint64_t*>(
                    reinterpret_cast<const std::uint8_t*>(cache_k) + code_off);
                const __half sc = cache_k_scale[scale_off];
                float fv[8];
                q4_0_dequant8(fv, codes8, (d0 & 16) == 0, sc);
#pragma unroll
                for (int r = 0; r < QR; ++r)
#pragma unroll
                    for (int j = 0; j < 8; ++j) s[r] += qr[r][j] * fv[j];
            } else if constexpr (KFp8) {
                const int page = block_table[key >> kPagedKVPageShift];
                const int page_off = key & kPagedKVPageMask;
                const __half kscale =
                    cache_k_scale[kv_cache_fp8_scale_index<Geometry>(page, kv_head, page_off)];
                const auto k_codes = reinterpret_cast<const std::uint8_t*>(cache_k);
                const float ksf = __half2float(kscale);
                float fv_k[8];
#pragma unroll
                for (int u = 0; u < 8; ++u) {
                    const std::int64_t code_off =
                        kv_cache_fp8_code_index<Geometry>(page, kv_head, lane + 32 * u, page_off);
                    const float v =
                        __half2float(kv_cache_fp8_code2_to_half2(k_codes[code_off]).x);
                    fv_k[u] = v * ksf;
                }
#pragma unroll
                for (int r = 0; r < QR; ++r)
#pragma unroll
                    for (int u = 0; u < 8; ++u) s[r] += q_rot[r][u] * fv_k[u];
            } else if constexpr (KInt4E8) {
                const int page = block_table[key >> kPagedKVPageShift];
                const int page_off = key & kPagedKVPageMask;
                const auto k_codes = reinterpret_cast<const std::uint8_t*>(cache_k);
                // PERF 2026-10-30 #3: eight scattered byte loads + eight scale loads per key
                // became one 4-byte word + one group scale. Dims 8*lane..8*lane+7 are
                // contiguous in the packed plane (byte b covers dims 8*lane+2b and +2b+1, low
                // nibble first) and they all fall inside the same 64-dim K scale group
                // ((8*lane)>>6), so a single scale is exact.
                const std::int64_t packed = kv_cache_int4_value_code_index<Geometry>(
                    page, kv_head, (lane * 8) >> 1, page_off);
                const std::uint32_t word =
                    *reinterpret_cast<const std::uint32_t*>(k_codes + packed);
                const float ksf = __half2float(cache_k_scale[
                    kv_cache_int8_quant_scale_index<Geometry>(page, kv_head, (lane * 8) >> 6,
                                                              page_off)]);
                float fv_k[8];
#pragma unroll
                for (int u = 0; u < 8; ++u) {
                    const int nib = static_cast<int>((word >> (4 * u)) & 0x0fu);
                    fv_k[u] = static_cast<float>((nib ^ 8) - 8) * ksf;
#if defined(NINFER_KERNEL_WITNESS)
                    w_ksum += fv_k[u];
#endif
                }
                if (skip_attn == 2 && blockIdx.x == 0 && blockIdx.y == 0 && tid == 0 &&
                    kb == split_start) {
                    printf("[simt-k] key=%d fv=%f,%f,%f,%f,%f,%f,%f,%f qrot=%f,%f,%f,%f\n",
                           key, (double)fv_k[0], (double)fv_k[1], (double)fv_k[2],
                           (double)fv_k[3], (double)fv_k[4], (double)fv_k[5], (double)fv_k[6],
                           (double)fv_k[7], (double)q_rotc[0][0], (double)q_rotc[0][1],
                           (double)q_rotc[0][2], (double)q_rotc[0][3]);
                }
#pragma unroll
                for (int r = 0; r < QR; ++r)
#pragma unroll
                    for (int j = 0; j < 8; ++j) s[r] += q_rotc[r][j] * fv_k[j];
            } else if constexpr (KFp16) {
                const int page = block_table[key >> kPagedKVPageShift];
                const int page_off = key & kPagedKVPageMask;
                const __half* k_row =
                    reinterpret_cast<const __half*>(cache_k) +
                    paged_kv_element_offset<D, Geometry::KVHeads>(page, kv_head, page_off, 0) +
                    d0;
#pragma unroll
                for (int r = 0; r < QR; ++r)
#pragma unroll
                    for (int j = 0; j < 8; ++j) s[r] += qr[r][j] * __half2float(k_row[j]);
            } else {
                const __nv_bfloat16* k_row = simt_k_ptr<Geometry>(cache_k, block_table, kv_head,
                                                                  key, d0);
#pragma unroll
                for (int r = 0; r < QR; ++r)
#pragma unroll
                    for (int j = 0; j < 8; ++j) s[r] += qr[r][j] * __bfloat162float(k_row[j]);
            }
        }
        // Prefetch this key's V row *before* the block-wide softmax: the byte load does not
        // depend on the softmax result, so issuing it here hides its DRAM latency behind the
        // barrier + exp math. The decode loop is latency-bound (MLP ~= 1 per warp), which is
        // why more warps / more CTAs never moved the needle; overlapping the two dependent
        // memory phases is what actually shortens it.
        __half v_pre[8];
        std::uint32_t v_word_pre = 0u;
        float v_sf_pre = 0.0f;
        const bool v_valid = key < split_end;
        if constexpr (!KQ4 && !KFp8 && !KInt4E8) {
            if (v_valid) {
                const __half* v_row = simt_v_ptr<Geometry>(cache_v, block_table, kv_head, key, d0);
#pragma unroll
                for (int j = 0; j < 8; ++j) v_pre[j] = v_row[j];
            }
        }
        if constexpr (KInt4E8) {
            // PERF 2026-10-30 #4: the V row used to be loaded *after* the softmax barrier, so its
            // DRAM latency sat exposed at the end of every 8-key batch (the int4 path was the only
            // storage format still doing this). Issue the word + group scale here instead: the
            // address depends only on the key, so it overlaps the barrier and the exp math.
            if (v_valid) {
                const int vpage = block_table[key >> kPagedKVPageShift];
                const int vpage_off = key & kPagedKVPageMask;
                const auto v_codes = reinterpret_cast<const std::uint8_t*>(cache_v);
                const std::int64_t vpacked = kv_cache_int4_value_code_index<Geometry>(
                    vpage, kv_head, (lane * 8) >> 1, vpage_off);
                v_word_pre = *reinterpret_cast<const std::uint32_t*>(v_codes + vpacked);
                v_sf_pre = __half2float(cache_v_scale[kv_cache_int4_value_scale_index<Geometry>(
                    vpage, kv_head, (lane * 8) >> 5, vpage_off)]);
            }
        }
#pragma unroll
        for (int off = 16; off > 0; off >>= 1)
#pragma unroll
            for (int r = 0; r < QR; ++r) s[r] += __shfl_xor_sync(0xffffffffu, s[r], off);
        if (lane == 0)
#pragma unroll
            for (int r = 0; r < QR; ++r) s_batch[r][warp] = s[r];
        __syncthreads();
        // One thread per q row (was: thread 0 doing all rows serially, which with 8 warps
        // and 6 rows put 48 max/exp ops on a single thread inside the barrier).
        if (tid < QR) {
            const int r = tid;
            // BUGFIX 2026-10-29: the online-softmax max must live in the *scaled* domain, the
            // same domain as p/alpha below. Mixing a raw-space bmax with scaled scores made every
            // exp underflow to 0 and left the running normaliser meaningless.
            float bmax = -CUDART_INF_F;
#pragma unroll
            for (int w = 0; w < Warps; ++w)
                if (kb + w < split_end)
                    bmax = fmaxf(bmax, s_batch[r][w] * scale);
            float bs = 0.0f;
#pragma unroll
            for (int w = 0; w < Warps; ++w)
                if (kb + w < split_end) bs += __expf(s_batch[r][w] * scale - bmax);
            m_upd[r] = bmax;
            l_batch[r] = bs;
            if (skip_attn == 2 && blockIdx.x == 0 && blockIdx.y == 0 && r == 0 &&
                kb == split_start) {
                printf("[simt-smax] bmax=%f bs=%f sb0=%f sb1=%f scale=%f\n", (double)bmax,
                       (double)bs, (double)s_batch[0][0], (double)s_batch[0][1], (double)scale);
            }
        }
        __syncthreads();
        float p[QR], alpha[QR];
#pragma unroll
        for (int r = 0; r < QR; ++r) {
            const float m_new = fmaxf(m[r], m_upd[r]);
            // BUGFIX 2026-10-30 #2: the batch exponentials (l_batch / p) are normalised
            // against the BATCH max m_upd, while the accumulators live in the RUNNING max
            // domain. alpha only rescales the old accumulator, so whenever m_upd < m (the
            // running max came from an earlier batch) the new keys entered inflated by
            // exp(m - m_upd) -> the softmax weights were only correct while the running max
            // kept growing. Canonical flash attention normalises the batch against the merged
            // max (small_t_bf16.cuh:337 uses nm0, not bm0): scale the batch by
            // beta = exp(m_upd - m_new) so l and p both land in the m_new domain.
            const float beta  = (m_upd[r] == -CUDART_INF_F) ? 0.0f : __expf(m_upd[r] - m_new);
            alpha[r]          = (m[r] == -CUDART_INF_F) ? 0.0f : __expf(m[r] - m_new);
            l[r]              = l[r] * alpha[r] + l_batch[r] * beta;
            m[r]              = m_new;
            p[r]              = (key < split_end) ? __expf(s[r] * scale - m_new) : 0.0f;
        }
#if defined(NINFER_KERNEL_WITNESS)
        w_psum += p[0];
#endif
        if (skip_attn == 2 && blockIdx.x == 0 && blockIdx.y == 0 && tid == 0 &&
            kb == split_start) {
            printf("[simt-upd] mupd=%f alpha=%f l=%f p=%f s=%f m=%f\n", (double)m_upd[0],
                   (double)alpha[0], (double)l[0], (double)p[0], (double)s[0], (double)m[0]);
        }
        if (key < split_end) {
            if constexpr (KQ4) {
                const int page = block_table[key >> kPagedKVPageShift];
                const int page_off = key & kPagedKVPageMask;
                const std::int64_t code_off = q4_0_code_offset<Geometry::KVHeads>(
                    page, kv_head, page_off, (d0 / kQ4_0Block) * kQ4_0Block) + (d0 & 15);
                const std::int64_t scale_off = q4_0_scale_offset<Geometry::KVHeads>(
                    page, kv_head, page_off, d0);
                const std::uint64_t codes8 = *reinterpret_cast<const std::uint64_t*>(
                    reinterpret_cast<const std::uint8_t*>(cache_v) + code_off);
                const __half sc = cache_v_scale[scale_off];
                float fv[8];
                q4_0_dequant8(fv, codes8, (d0 & 16) == 0, sc);
#pragma unroll
                for (int r = 0; r < QR; ++r)
#pragma unroll
                    for (int j = 0; j < 8; ++j) o[r][j] = o[r][j] * alpha[r] + p[r] * fv[j];
            } else if constexpr (KFp8) {
                const int page = block_table[key >> kPagedKVPageShift];
                const int page_off = key & kPagedKVPageMask;
                const __half vscale =
                    cache_v_scale[kv_cache_fp8_scale_index<Geometry>(page, kv_head, page_off)];
                const auto v_codes = reinterpret_cast<const std::uint8_t*>(cache_v);
                const float vsf = __half2float(vscale);
                float fv_v[8];
#pragma unroll
                for (int u = 0; u < 8; ++u) {
                    const std::int64_t code_off =
                        kv_cache_fp8_code_index<Geometry>(page, kv_head, lane + 32 * u, page_off);
                    const float v =
                        __half2float(kv_cache_fp8_code2_to_half2(v_codes[code_off]).x);
                    fv_v[u] = v * vsf;
                }
#pragma unroll
                for (int r = 0; r < QR; ++r)
#pragma unroll
                    for (int u = 0; u < 8; ++u)
                        o[r][u] = o[r][u] * alpha[r] + p[r] * fv_v[u];
            } else if constexpr (KInt4E8) {
                // PERF 2026-10-30 #3: one 4-byte word + one 32-dim group scale instead of eight
                // scattered byte loads and eight scale loads. Dims 8*lane..8*lane+7 all fall in
                // the same V scale group ((8*lane)>>5), so the single scale is exact. o[r][j]
                // now holds output dim 8*lane+j, hence the natural-order write-back below.
                // PERF 2026-10-30 #4: the word/scale arrive via v_word_pre/v_sf_pre (loaded
                // before the softmax barrier, see above) instead of here.
                float fv_v[8];
#pragma unroll
                for (int u = 0; u < 8; ++u) {
                    const int nib = static_cast<int>((v_word_pre >> (4 * u)) & 0x0fu);
                    fv_v[u] = static_cast<float>((nib ^ 8) - 8) * v_sf_pre;
#if defined(NINFER_KERNEL_WITNESS)
                    w_vsum += fv_v[u];
#endif
                }
#pragma unroll
                for (int r = 0; r < QR; ++r)
#pragma unroll
                    for (int u = 0; u < 8; ++u)
                        o[r][u] = o[r][u] * alpha[r] + p[r] * fv_v[u];
            } else {
                // v_pre was loaded before the softmax barrier (see above).
#pragma unroll
                for (int r = 0; r < QR; ++r)
#pragma unroll
                    for (int j = 0; j < 8; ++j)
                        o[r][j] = o[r][j] * alpha[r] + p[r] * __half2float(v_pre[j]);
            }
        } else {
#pragma unroll
            for (int r = 0; r < QR; ++r)
#pragma unroll
                for (int j = 0; j < 8; ++j) o[r][j] *= alpha[r];
        }
        __syncthreads();  // guards the next batch's s_batch/m_upd writes
    }

    if (skip_attn == 2 && blockIdx.y == 0 && tid == 0) {
        printf("[simt-dbg2] bx=%d q0=%d kvh=%d l=%f,%f,%f,%f,%f,%f o0=%f,%f,%f,%f,%f,%f\n",
               (int)blockIdx.x, q0, kv_head,
               (double)l[0], (double)l[1], (double)l[2], (double)l[3], (double)l[4], (double)l[5],
               (double)o[0][0], (double)o[1][0], (double)o[2][0], (double)o[3][0], (double)o[4][0], (double)o[5][0]);
    }
#if defined(NINFER_KERNEL_WITNESS)
    {
#pragma unroll
        for (int off = 16; off > 0; off >>= 1) {
            w_vsum += __shfl_xor_sync(0xffffffffu, w_vsum, off);
            w_ksum += __shfl_xor_sync(0xffffffffu, w_ksum, off);
            w_psum += __shfl_xor_sync(0xffffffffu, w_psum, off);
            w_pgs  += __shfl_xor_sync(0xffffffffu, w_pgs, off);
        }
        if (lane == 0 && warp == 0) {
            const std::int64_t wbase = static_cast<std::int64_t>(blockIdx.x) * 32 + split;
            partial_acc[768 * D + wbase] = w_vsum;
            partial_acc[769 * D + wbase] = w_ksum;
            partial_acc[770 * D + wbase] = w_psum;
            partial_acc[771 * D + wbase] = w_pgs;
        }
    }
#endif
    // Canonical [split][token][q_head] partial layout (tokens == 1), i.e. exactly what
    // causal_partial_stat_index / causal_partial_acc_index describe and what the reduce kernel
    // reads. The accumulator stays UNNORMALISED: the reducer divides the weighted sum of the
    // per-split numerators by the weighted sum of the per-split l values (small_t.cuh:264), so
    // pre-dividing here would normalise twice and shrink the attention output by ~1/l.
    if (tid == 0) {
#pragma unroll
        for (int r = 0; r < QR; ++r) {
            const std::int64_t stat =
                (q0 + r) + Geometry::QHeads * static_cast<std::int64_t>(split);
            // ROOT-CAUSE FIX 2026-10-30: m[] already lives in the SCALED domain (m_upd =
            // max(s*scale), p = exp(s*scale - m_upd)), which is exactly the domain
            // causal_merge_split_statistics expects (it stages score*scale and stores that
            // max; see decode_t1_wmma.cuh:1375-1380). The old "* scale" here was a leftover
            // from the raw-domain original and published m scaled TWICE (m*0.0625), which
            // flattened the cross-split weights exp(m_s - max) to nearly uniform: every T=1
            // decode attention became a wrong split average (garbled retrieval / copy and
            // needle failures) while the residual magnitude stayed plausible.
            partial_m[stat] = m[r];
            partial_l[stat] = l[r];
        }
    }
    // AMD port FIX 2026-10-30: o is per-WARP state. Warp w only ever touches keys kb+w of each
    // batch, so the block-wide online-softmax numerator for a split is the SUM of the 8 warps'
    // o. The write-back used to store every warp's o straight into partial_acc[acc_base+lane+..]
    // - eight threads racing on each element - so the surviving value was whichever warp stored
    // last: the numerator was ~1/8 of the true one AND changed run to run. That race is exactly
    // the MTP verify / AR decode nondeterminism (m and l stayed stable because they are
    // block-reduced through s_batch/m_upd/l_batch).
    // Stage one (r, u) slice at a time: o[QR][8] holds EIGHT dims per lane, so the staging
    // buffer must be indexed by slice as well. Staging only [Warps][32] keeps the block's
    // static shared footprint at 1 KiB instead of QR*Warps*8*32 floats.
    __shared__ float o_stage[Warps][32];
#pragma unroll
    for (int r = 0; r < QR; ++r) {
#pragma unroll
        for (int u = 0; u < 8; ++u) {
            o_stage[warp][lane] = o[r][u];
            __syncthreads();
            if (warp == 0) {
                const std::int64_t acc_base =
                    ((q0 + r) + Geometry::QHeads * static_cast<std::int64_t>(split)) * D;
                // Fixed w order keeps the sum bit-reproducible.
                float partial = o_stage[0][lane];
#pragma unroll
                for (int w = 1; w < Warps; ++w) partial += o_stage[w][lane];
                if constexpr (KInt4E8) {
                    // int4 reads/writes dims 8*lane..8*lane+7 per lane (contiguous read path).
                    partial_acc[acc_base + lane * 8 + u] = partial;
                } else if constexpr (KFp8) {
                    // fp8 still owns dims lane+32*u.
                    partial_acc[acc_base + lane + 32 * u] = partial;
                } else {
                    partial_acc[acc_base + lane * 8 + u] = partial;
                }
#if defined(NINFER_KERNEL_WITNESS)
                if (blockIdx.x == 0 && blockIdx.y == 0 && r < 2) {
                    partial_acc[(772 + r) * D + lane + 32 * u] = partial;
                }
#endif
            }
            __syncthreads();
        }
    }
}

